# ═══════════════════════════════════════════════════════════════════════════
# DEX - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed.
# All variables are optional - DEX works fully offline with defaults.
# ═══════════════════════════════════════════════════════════════════════════

# Development
NODE_ENV=development
DEX_DEBUG=false
DEX_LOG_LEVEL=info

# Application
DEX_PORT=3000
DEX_API_PORT=9120

# Python Bridge (optional - for advanced system features)
PYTHON_PATH=python3
PYTHON_BRIDGE_ENABLED=false

# Feature Flags
DEX_FEATURE_POWER_MANAGEMENT=true
DEX_FEATURE_VOICE_CONTROL=true
DEX_FEATURE_EXPERT_MODE=false
DEX_FEATURE_AI_SUGGESTIONS=false

# Security
DEX_SESSION_TIMEOUT_MINUTES=30
DEX_MAX_LOGIN_ATTEMPTS=5
DEX_LOCKOUT_DURATION_MINUTES=15

# Performance
DEX_MAX_MEMORY_MB=512
DEX_MAX_CPU_PERCENT=80
DEX_BACKGROUND_TASK_LIMIT=10

# Updates (GitHub releases)
DEX_AUTO_CHECK_UPDATES=true
DEX_UPDATE_CHANNEL=stable
