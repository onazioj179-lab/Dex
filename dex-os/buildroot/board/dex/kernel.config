# ===========================================================================
# DEX OS -- Linux Kernel Config Fragment
# ===========================================================================
# Applied on top of x86_64_defconfig to enable hardware needed by DEX.
# ===========================================================================

# -- EFI boot support ---------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# -- Filesystem ---------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_NTFS3_FS=y
CONFIG_EXFAT_FS=y

# -- GPU / DRM (Intel, AMD, NVIDIA nouveau) -----------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_FBDEV_EMULATION=y

# -- Sound (ALSA + HDA) -------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y

# -- USB ----------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# -- Networking ---------------------------------------------------------------
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_WLAN=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_MT7921E=y
CONFIG_RTW88=y
CONFIG_RTW89=y

# -- Input devices ------------------------------------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_HID_GENERIC=y

# -- Power management ---------------------------------------------------------
CONFIG_ACPI=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# -- Inotify (DEX file watcher) -----------------------------------------------
CONFIG_INOTIFY_USER=y

# -- Misc performance ---------------------------------------------------------
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
