{
  "name": "dex",
  "version": "7.0.1",
  "dexBuild": "18i",
  "description": "DEX OS - a desktop environment for Windows by Onazi oJ",
  "author": "Onazi Treasure OJ <onazi75@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/onazioj179-lab/Dex",
  "repository": {
    "type": "git",
    "url": "https://github.com/onazioj179-lab/Dex.git"
  },
  "scripts": {
    "clean": "rimraf dist release",
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "build:native": "cd native && npm install && npx napi build --platform --release",
    "build:native:debug": "cd native && npm install && npx napi build --platform",
    "build:core": "node scripts/build-dex-core.js",
    "backlog:build": "node scripts/build-master-backlog.js",
    "backlog:sprints": "node scripts/split-sprints.js",
    "build:all": "npm run build:native && npm run build:core && npm run build:tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build && node scripts/verify-tauri-bundle.js",
    "verify:bundle": "node scripts/verify-tauri-bundle.js",
    "release:checksums": "node scripts/release-checksums.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:legacy": "node tests/run-tests.js",
    "package": "npm run build:tauri",
    "generate-icons": "node scripts/generate-icons.js",
    "watermark": "node scripts/add-watermarks.js",
    "watermark:check": "node scripts/add-watermarks.js --check",
    "lint": "tsc --noEmit && node scripts/add-watermarks.js --check",
    "release:prune": "node scripts/prune-releases.js --repo onazioj179-lab/Dex --keep 3",
    "release:prune:updates": "node scripts/prune-releases.js --repo onazioj179-lab/dex-updates --keep 3",
    "release:prune:all": "npm run release:prune && npm run release:prune:updates",
    "release:prune:dry": "node scripts/prune-releases.js --repo onazioj179-lab/Dex --keep 3 --dry-run"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.3.1",
    "idb-keyval": "^6.2.2",
    "maplibre-gl": "^5.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.0.18"
  }
}
