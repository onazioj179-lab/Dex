{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEX",
  "version": "7.0.2",
  "identifier": "com.onazioj.dex",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DEX",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MENFNTc3NEUxRjMzNjAKUldSZ014OU9kK1VNVnd0aldBR1hROW5xb1R4TlJVZGtxV1hOUGhNNHh4eEg4QzNOeHovVCswMGwK",
      "endpoints": ["https://github.com/onazioj179-lab/Dex/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Onazi oJ",
    "copyright": "Copyright (c) 2026 Onazi Treasure OJ. DEX OS created by Onazi oJ.",
    "category": "Productivity",
    "shortDescription": "DEX OS",
    "longDescription": "DEX OS: a desktop environment for Windows. Created by Onazi oJ.",
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "../NOTICE": "NOTICE.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../assets/icon.ico"
      }
    }
  }
}
