{
  "name": "dex-core",
  "version": "1.0.0",
  "private": true,
  "description": "DEX Core Rust native addon (performance layer)",
  "main": "index.js",
  "napi": {
    "name": "dex-core",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
